<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_slate">

    <include
        android:id="@+id/toolbarInclude"
        layout="@layout/toolbar_standard"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Greeting Header -->
    <LinearLayout
        android:id="@+id/greetingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/card_surface"
        app:layout_constraintTop_toBottomOf="@id/toolbarInclude">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_person"
            android:background="@drawable/btn_send_circle"
            android:padding="6dp"
            android:contentDescription="Citizen"
            app:tint="@color/bg_dark_slate" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Hello, Citizen"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mistral AI"
            android:textSize="12sp"
            android:textColor="@color/mint_green"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/greetingHeader"
        app:layout_constraintBottom_toTopOf="@id/inputBar" />

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@color/card_surface"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_mic"
            android:background="@drawable/btn_mic_circle"
            android:contentDescription="Voice input"
            app:tint="@color/text_light" />

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:hint="Ask about roads..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:background="@drawable/input_chat_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/btn_send_circle"
            android:contentDescription="Send message"
            android:padding="10dp" />
    </LinearLayout>

    <!-- Listening Overlay -->
    <FrameLayout
        android:id="@+id/listeningOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC1A1F2E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/listening_dialog_bg"
            android:padding="32dp"
            android:minWidth="240dp">

            <ImageView
                android:id="@+id/listeningPulse"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/listening_pulse"
                android:padding="20dp"
                android:contentDescription="Listening"
                app:tint="@color/text_light" />

            <TextView
                android:id="@+id/listeningText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Listening..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Speak now"
                android:textSize="13sp"
                android:textColor="@color/text_muted" />

            <Button
                android:id="@+id/btnCancelListening"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Cancel"
                android:textColor="@color/coral_red"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


