<?xml version="1.0" encoding="utf-8"?>
<!--
    Standard toolbar included in all secondary activities.
    BaseActivity.setupToolbar() wires up the back arrow and title.
-->
<androidx.appcompat.widget.Toolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/bg_dark_slate"
    android:elevation="4dp"
    app:titleTextColor="@color/text_light"
    app:subtitleTextColor="#9CA3AF"
    app:navigationIconTint="@color/text_light"
    app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />


