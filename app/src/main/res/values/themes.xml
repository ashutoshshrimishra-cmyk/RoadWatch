<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Single DayNight theme. Color *values* swap via values-night/colors.xml
        so existing layout references like @color/bg_dark_slate keep working
        and just point at the right shade for each mode.
    -->
    <style name="Theme.RoadWatch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mint_green</item>
        <item name="colorOnPrimary">@color/bg_dark_slate</item>
        <item name="colorSecondary">@color/coral_red</item>
        <item name="colorOnSecondary">@color/text_light</item>
        <item name="android:colorBackground">@color/bg_dark_slate</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_light</item>
        <item name="colorOnBackground">@color/text_light</item>
        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:windowBackground">@color/bg_dark_slate</item>
    </style>

    <style name="Circular" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Splash theme: full-bleed brand colour, no action bar, no status bar overlap. -->
    <style name="Theme.RoadWatch.Splash" parent="Theme.RoadWatch">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
