<?xml version="1.0" encoding="utf-8"?>
<!--
    CRITICAL FIX: Replaces android:usesCleartextTraffic="true" in the manifest.
    This config allows cleartext ONLY for localhost/10.0.2.2 (emulator dev),
    while enforcing HTTPS for all production traffic.
-->
<network-security-config>
    <!-- Production: HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development: allow cleartext to localhost, Android emulator host, and the
         backend dev server (HTTP only — no TLS available on this IP). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">16.176.208.7</domain>
        <domain includeSubdomains="false">13.55.212.9</domain>
    </domain-config>
</network-security-config>
